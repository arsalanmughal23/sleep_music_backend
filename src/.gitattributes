# PHP files
*.php text diff=php

# Blade templates
*.blade.php text diff=blade

# JS/TS files
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf

# CSS/SCSS files
*.css text
*.scss text
*.sass text

# Config files
*.yml text
*.yaml text
*.json text
*.xml text

# Shell scripts
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.svg binary

# Artisan
artisan text eol=lf

# Export-ignore
/tests export-ignore
/phpunit.xml export-ignore
/.editorconfig export-ignore